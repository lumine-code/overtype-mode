{
  // The Insert key meaning overtype is a convention older than any editor here,
  // so it keeps the unmodified global key.
  "lumine-workspace": {
    "insert": "overtype-mode:toggle-global"
  },
  // :not([mini]) because the per-editor mode is about the file you are editing.
  "lumine-text-editor:not([mini])": {
    "alt-insert": "overtype-mode:toggle-editor"
  }
}
